---
import profile from '../data/profile.json';
const { title, description = profile.headline } = Astro.props;
const nav = [['/', 'Home'],['/about','About'],['/resume','Resume'],['/projects','Projects'],['/skills','Skills'],['/contact','Contact']];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | {profile.name}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} | ${profile.name}`} /><meta property="og:description" content={description} />
  <style is:global>
    :root{--ink:#0e1a1f;--ink2:#16262d;--paper:#f7f9f8;--text:#1b2a2f;--muted:#51636a;--accent:#0f8f6a;--accent-l:#5fe0b4;--line:#dbe4e1;--r:10px}
    *{box-sizing:border-box}
    body{margin:0;font:17px/1.65 system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--text);background:var(--paper)}
    a{color:var(--accent)} a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
    .wrap{max-width:960px;margin:0 auto;padding:0 1.25rem}
    header.site{background:var(--ink)} header.site .wrap{display:flex;gap:1rem;justify-content:space-between;align-items:center;flex-wrap:wrap;padding-top:.9rem;padding-bottom:.9rem}
    header.site a{color:#cfe0db;text-decoration:none;padding:.3rem .55rem;border-radius:6px} header.site a[aria-current=page]{color:#fff;background:var(--ink2)}
    nav{display:flex;flex-wrap:wrap;gap:.25rem}
    .hero{background:var(--ink);color:#e8f1ee;padding:4.5rem 0 5rem} .hero h1{font-size:clamp(2.2rem,6vw,3.6rem);line-height:1.1;margin:0 0 .5rem;letter-spacing:-.02em}
    .hero p{max-width:60ch;color:#b7cbc5} .hero .lead{color:var(--accent-l);font-size:1.25rem}
    main section{padding:2.5rem 0} h2{margin-top:0}
    .btns{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.5rem}
    .btn{display:inline-block;padding:.65rem 1.1rem;border-radius:8px;border:1.5px solid var(--accent);color:var(--accent);text-decoration:none;font-weight:600}
    .btn.primary{background:var(--accent);color:#fff} .hero .btn{border-color:var(--accent-l);color:var(--accent-l)} .hero .btn.primary{background:var(--accent-l);color:var(--ink)}
    .grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(270px,1fr))}
    .card{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:1.1rem}
    .card h3{margin:.2rem 0}.meta{color:var(--muted);font-size:.9rem}
    .tag,.badge{display:inline-block;font-size:.8rem;border:1px solid var(--line);border-radius:99px;padding:.05rem .6rem;margin:.15rem .2rem .15rem 0;background:#fff}
    .badge.Completed,.badge.Demonstrated{border-color:var(--accent);color:var(--accent)} .badge.Planned{border-style:dashed}
    .empty{border:1.5px dashed var(--line);border-radius:var(--r);padding:1.5rem;color:var(--muted)}
    .tl{list-style:none;padding:0;border-left:3px solid var(--line);margin-left:.4rem} .tl li{padding:0 0 1.2rem 1.2rem}
    input,select{font:inherit;padding:.55rem .7rem;border:1px solid var(--line);border-radius:8px;background:#fff}
    footer{border-top:1px solid var(--line);padding:2rem 0;color:var(--muted)}
    @media (prefers-reduced-motion:no-preference){.hero .wrap{animation:in .6s ease both}@keyframes in{from{opacity:0;transform:translateY(10px)}}}
  </style>
</head>
<body>
  <header class="site"><div class="wrap"><a href="/"><strong>{profile.name}</strong></a>
    <nav aria-label="Main">{nav.map(([h,l])=><a href={h} aria-current={path===h||(h!=='/'&&path.startsWith(h))?'page':undefined}>{l}</a>)}</nav></div></header>
  <slot name="hero" />
  <main class="wrap"><slot /></main>
  <footer><div class="wrap">© {new Date().getFullYear()} {profile.name}. Built with Astro, hosted on GitHub Pages.</div></footer>
</body></html>
